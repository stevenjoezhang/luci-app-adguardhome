config AdGuardHome 'AdGuardHome'
	option enabled '0'
	option httpport '3000'
	option redirect 'none'
	option configpath '/etc/AdGuardHome.yaml'
	option workdir '/usr/bin/AdGuardHome'
	option logfile '/tmp/AdGuardHome.log'
	option verbose '0'
	option binpath '/usr/bin/AdGuardHome/AdGuardHome'
	option upxflag ''
	option upstream_enabled '0'
	option upstream_dns_file '/usr/bin/AdGuardHome/upstream_dns.conf'
	option domain_subscription_urls 'https://cdn.jsdelivr.net/gh/gfwlist/gfwlist/gfwlist.txt'
	option global_upstreams 'https://dns.alidns.com/dns-query
https://doh.pub/dns-query'
	option domain_upstreams 'https://dns.google/dns-query'
	option upstream_cron '30 4 * * *'
	list upprotect '$binpath'
	list upprotect '$configpath'
	option downloadlinks 'https://static.adguard.com/adguardhome/release/AdGuardHome_linux_${Arch}.tar.gz
#https://static.adguard.com/adguardhome/beta/AdGuardHome_linux_${Arch}.tar.gz
https://github.com/AdguardTeam/AdGuardHome/releases/download/${latest_ver}/AdGuardHome_linux_${Arch}.tar.gz'
